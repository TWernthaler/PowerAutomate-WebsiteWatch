# Copy to .env (local only) and store sensitive values in your password safe.
# Do not commit .env.
# Values are treated as plain text (no escape-sequence processing).
# Inline comments are stripped only when prefixed by whitespace: VALUE # comment

SITE_URL=https://tenant.sharepoint.com/sites/Automation
CLIENT_ID=00000000-0000-0000-0000-000000000000
LIST_NAME=WebMonitoring
TEAMS_TEAM_ID=00000000-0000-0000-0000-000000000000
TEAMS_CHANNEL_ID=19:00000000000000000000000000000000@thread.tacv2
TEAMS_TEAM_NAME=IT Automation
TEAMS_CHANNEL_NAME=website-monitoring
FLOW_SOLUTION_PATH=./powerplatform/WebsiteMonitoring.zip

# For quote characters in values, use single-quoted syntax, e.g.:
# MATCH_END='"'

# Example monitoring target: Windows 11 Version 26H2 update history
EXAMPLE_TARGET_TITLE=Windows 11 Version 26H2 Update History
EXAMPLE_TARGET_URL=https://support.microsoft.com/de-de/servicing/os/windows-11/2026/09/windows-11-version-26h2-update-history
EXAMPLE_TARGET_MATCH_START='<meta name="git_commit_id" content="'
EXAMPLE_TARGET_MATCH_END='"'
